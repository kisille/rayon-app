# ──────────────────────────────────────────────────────────────────────────────
# Post Rayon-Verwaltung – Umgebungsvariablen
# Kopieren nach ".env" und alle Werte anpassen:
#   cp .env.example .env
#   chmod 600 .env
# ──────────────────────────────────────────────────────────────────────────────

# PFLICHTFELD: Langen zufälligen Schlüssel setzen (mind. 64 Zeichen)
# Generieren: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ACHTUNG: Bei Neustart mit anderem JWT_SECRET werden alle aktiven Sessions ungültig!
JWT_SECRET=<hier-64-stelligen-hex-string-einfügen>

# PFLICHTFELD: Produktions-URL der Anwendung (ohne abschließenden Slash)
# Beispiel: https://rayon.post.at
CORS_ORIGIN=https://rayon.post.at

# Pfad zum Verzeichnis mit TLS-Zertifikaten (fullchain.pem + privkey.pem)
# Let's Encrypt Beispiel: /etc/letsencrypt/live/rayon.post.at
# Eigenes Zertifikat:      ./certs
TLS_CERT_DIR=./certs

# Optional: Initiales Admin-Passwort beim ersten Start
# Wenn nicht gesetzt, wird ein zufälliges Passwort generiert und in den Logs angezeigt.
# ADMIN_PASSWORT=<sicheres-startpasswort>
