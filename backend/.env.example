# ─── Rayon-App Backend – Umgebungsvariablen ────────────────────────────────────
# Kopiere diese Datei zu ".env" und passe die Werte an.
# WICHTIG: Die .env-Datei NIEMALS ins Git einchecken!

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001

# ── Sicherheit ─────────────────────────────────────────────────────────────────
# JWT-Signierungsschlüssel – mindestens 64 zufällige Zeichen!
# Generieren mit: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=HIER_EINEN_LANGEN_ZUFAELLIGEN_SCHLUESSEL_EINSETZEN

# Erlaubte Frontend-Herkunft(en) für CORS (kommagetrennt bei mehreren)
# Produktionsbeispiel: https://rayon.post.at
CORS_ORIGIN=http://localhost:5173

# ── Datenbank ──────────────────────────────────────────────────────────────────
# Pfad zur SQLite-Datenbankdatei
DB_PATH=./rayon.db

# ── Ersteinrichtung ────────────────────────────────────────────────────────────
# Initiales Admin-Passwort (nur beim ersten Start, wenn noch kein Benutzer existiert).
# Wenn nicht gesetzt, wird ein zufälliges Passwort generiert und einmalig geloggt.
# Nach dem ersten Login bitte sofort im Benutzer-Menü ändern!
# ADMIN_PASSWORT=

# ── Frontend (optional, für Standalone-Betrieb) ────────────────────────────────
# Pfad zum gebauten Frontend-Verzeichnis (dist/)
# FRONTEND_DIST=../frontend/dist
